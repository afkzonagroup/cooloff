{
  "name": "afkzona/cooloff-woocommerce",
  "description": "Development tools for the Cooloff WooCommerce plugin. The plugin itself has no Composer dependencies.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "11.5.57",
    "wp-coding-standards/wpcs": "3.4.1",
    "phpcompatibility/phpcompatibility-wp": "2.1.8",
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
