{
  "name": "@afkzona/cooloff-medusa",
  "version": "0.1.0",
  "description": "Medusa v2 plugin for the withdrawal function of Article 11a of the Consumer Rights Directive 2011/83/EU (Directive (EU) 2023/2673).",
  "license": "Apache-2.0",
  "author": "MB AFKzona Group",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/cooloff.git",
    "directory": "connectors/medusa"
  },
  "keywords": [
    "medusa",
    "medusa-plugin",
    "medusa-v2",
    "withdrawal",
    "consumer-rights-directive"
  ],
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "medusa plugin:build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "integration-tests/run.sh",
    "db:generate": "medusa plugin:db:generate",
    "prepublishOnly": "node -e \"const d=require('./package.json').dependencies||{};if(Object.values(d).some((v)=>v.startsWith('file:'))){console.error('Replace file: dependencies with the published version of @afkzona/cooloff first');process.exit(1)}\""
  },
  "dependencies": {
    "@afkzona/cooloff": "file:../.."
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.22.0",
    "@medusajs/cli": "2.22.0",
    "@medusajs/framework": "2.22.0",
    "@medusajs/icons": "2.22.0",
    "@medusajs/js-sdk": "2.22.0",
    "@medusajs/medusa": "2.22.0",
    "@medusajs/test-utils": "2.22.0",
    "@medusajs/ui": "4.2.7",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.12",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "jest": "30.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.22.0",
    "@medusajs/medusa": "2.22.0"
  }
}
