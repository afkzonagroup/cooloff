{
  "name": "@afkzona/cooloff",
  "version": "0.1.1",
  "description": "Withdrawal function for online shops under Article 11a of the Consumer Rights Directive 2011/83/EU (inserted by Directive (EU) 2023/2673): web component, server handlers and acknowledgement of receipt.",
  "license": "Apache-2.0",
  "author": "MB AFKzona Group",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afkzonagroup/cooloff.git"
  },
  "homepage": "https://github.com/afkzonagroup/cooloff#readme",
  "bugs": {
    "url": "https://github.com/afkzonagroup/cooloff/issues"
  },
  "keywords": [
    "consumer-rights-directive",
    "withdrawal",
    "right-of-withdrawal",
    "2023/2673",
    "article-11a",
    "web-component",
    "ecommerce",
    "eu"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/component/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./node": {
      "types": "./dist/server/node.d.ts",
      "default": "./dist/server/node.js"
    },
    "./express": {
      "types": "./dist/server/express.d.ts",
      "default": "./dist/server/express.js"
    },
    "./next": {
      "types": "./dist/server/next.d.ts",
      "default": "./dist/server/next.js"
    },
    "./file-store": {
      "types": "./dist/server/file-store.d.ts",
      "default": "./dist/server/file-store.js"
    },
    "./component": {
      "types": "./dist/component/index.d.ts",
      "default": "./dist/component/index.js"
    },
    "./component/define": {
      "types": "./dist/component/define.d.ts",
      "default": "./dist/component/define.js"
    },
    "./labels.json": "./data/labels.json",
    "./messages.json": "./data/messages.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!dist/**/*.tsbuildinfo",
    "data/labels.json",
    "data/messages.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "labels:json": "npm run build && node scripts/write-labels-json.mjs",
    "labels:verify": "npm run build && node scripts/verify-labels-eurlex.mjs",
    "example": "npm run build && node examples/basic/server.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "express": "5.3.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
